  elements.renderResult.innerHTML = '';
  setStatus('Ø¬Ø§Ø±ÙŠ Ø§Ù„Ø±Ù†Ø¯Ø±', 'ÙŠØªÙ… Ø§Ù„Ø¢Ù† ØªØ¬Ù‡ÙŠØ² Ø§Ù„ÙÙŠØ¯ÙŠÙˆ.');
