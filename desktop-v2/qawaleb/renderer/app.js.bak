function hasExactPreviewPlayer() {
  const api = templatePreviewApi();
  return Boolean(api && typeof api.mount === 'function' && typeof api.update === 'function');
}

function templatePreviewApi() {
  return window.DesktopRemotionPreviewQawaleb || window.window?.DesktopRemotionPreviewQawaleb || null;
}

function isTemplatePreviewMode() {
  return Boolean(TEMPLATE_PRESETS.length && getTemplatePreset());
}

function getTemplatePreviewDurationMs() {
  return Math.max(1000, Number(state.slideDurationInSeconds || 20) * 1000);
}

function getTemplatePreviewDurationInFrames() {
  return Math.max(25, Math.round((getTemplatePreviewDurationMs() / 1000) * FPS));
}

function updateTemplateRuntimeSummary() {
  const preset = getTemplatePreset();
  const durationSeconds = (getTemplatePreviewDurationMs() / 1000).toFixed(1);

  if (elements.runtimeSummary) {
    elements.runtimeSummary.textContent = preset ? `${durationSeconds}Ø«` : '';
    elements.runtimeSummary.title = preset ? `Ø§Ù„Ù…Ø¯Ø© Ø§Ù„ØªÙ‚Ø±ÙŠØ¨ÙŠØ©: ${durationSeconds} Ø«Ø§Ù†ÙŠØ©` : '';
  }

  if (elements.previewSummary) {
    elements.previewSummary.textContent = preset
      ? `Ø§Ù„Ù‚Ø§Ù„Ø¨ Ø§Ù„Ø­Ø§Ù„ÙŠ: ${preset.label} | Ø§Ù„Ù…Ø¯Ø© Ø§Ù„ØªÙ‚Ø±ÙŠØ¨ÙŠØ©: ${durationSeconds} Ø«Ø§Ù†ÙŠØ©`
      : 'Ø§Ø®ØªØ± Ù‚Ø§Ù„Ø¨Ù‹Ø§ØŒ Ø«Ù… Ø¹Ø¯Ù‘Ù„ Ø§Ù„Ø¨ÙŠØ§Ù†Ø§Øª Ù…Ù† Ø§Ù„ØªØ¨ÙˆÙŠØ¨ Ø§Ù„Ù…Ù‚Ø§Ø¨Ù„.';
  }
}

function normalizeTemplatePreviewValue(value) {
  if (typeof value !== 'string' || value.length === 0) {
    return value;
  }

  if (/^(https?:|data:|blob:|file:)/i.test(value)) {
    return value;
  }

  if (/^[a-zA-Z]:[\\/]/.test(value) || value.startsWith('\\\\')) {
    return window.desktopApi.toFileUrl(value);
  }

  return value;
}

function getTemplatePreviewSource(preset) {
  return new URL(`../templates/${encodeURIComponent(preset.fileName)}`, window.location.href).href + '?embed=1';
}

function getTemplatePreviewSignature(preset) {
  return JSON.stringify({
    templateId: preset?.id || '',
    values: state.templateValues,
    colors: state.templateColors,
    frame: state.frame || '',
    templateScale: state.templateScale,
    templateX: state.templateX,
    templateY: state.templateY,
    textFontSize: state.textFontSize,
  });
}

function postTemplatePreviewMessage(message) {
  const frameWindow = exactPreviewRef.iframe?.contentWindow;
  if (!frameWindow) {
    return false;
  }

  frameWindow.postMessage(message, '*');
  return true;
}

function syncTemplatePreviewUi() {
  const totalMs = getTemplatePreviewDurationMs();
  state.previewPositionMs = clamp(state.previewPositionMs, 0, totalMs || 0);
  updatePreviewPlayerUi({ totalMs });
  syncPreviewButtonUi({ totalMs });
}

function syncTemplatePreviewContent(force = false) {
  const preset = getTemplatePreset();
  if (!preset || !exactPreviewRef.loaded) {
    return false;
  }

  const signature = getTemplatePreviewSignature(preset);
  if (!force && exactPreviewRef.signature === signature) {
    return false;
  }

  postTemplatePreviewMessage({
    type: 'qawaleb:update',
    values: { ...state.templateValues },
    autoplay: false,
    timeMs: 0,
  });

  if (state.previewPositionMs > 0) {
    postTemplatePreviewMessage({
      type: 'qawaleb:seek',
      timeMs: state.previewPositionMs,
      playing: state.previewPlaying,
    });
  }

  if (state.previewPlaying) {
    postTemplatePreviewMessage({
      type: 'qawaleb:set-playing',
      playing: true,
    });
  }

  exactPreviewRef.signature = signature;
  return true;
}

function ensureDesktopQawalebFonts(arabicFontDataUrl, displayFontDataUrl) {
  if ((!arabicFontDataUrl && !displayFontDataUrl) || document.head.querySelector('[data-desktop-font="QawalebFonts"]')) {
    return;
  }

  const style = document.createElement('style');
  style.setAttribute('data-desktop-font', 'QawalebFonts');
  style.textContent = `
    ${arabicFontDataUrl ? `
    @font-face {
      font-family: 'QawalebArabic';
      src: url('${arabicFontDataUrl}') format('opentype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }` : ''}
    ${displayFontDataUrl ? `
    @font-face {
      font-family: 'QawalebDisplay';
      src: url('${displayFontDataUrl}') format('truetype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }` : ''}
  `;
  document.head.appendChild(style);
}

function formatAssetOptions(select, items, placeholder) {
  select.innerHTML = '';

  const emptyOption = document.createElement('option');
  emptyOption.value = '';
  emptyOption.textContent = placeholder;
  select.appendChild(emptyOption);

  items.forEach((item) => {
    const option = document.createElement('option');
    option.value = item.name;
    option.textContent = item.name;
    select.appendChild(option);
  });
}

function prettifyPath(filePath) {
  return filePath.split(/[/\\]/).pop() || filePath;
}

function setStatus(title, text) {
  elements.statusTitle.textContent = title;
  elements.statusText.textContent = text || '';
  elements.statusText.style.display = text ? '' : 'none';
}

function setProgress(progress, message) {
  const safeProgress = Math.max(0, Math.min(1, progress || 0));
  elements.progressFill.style.width = `${safeProgress * 100}%`;
  elements.progressPercent.textContent = `${Math.round(safeProgress * 100)}%`;
  elements.progressLabel.textContent = message || 'Ø¬Ø§Ù‡Ø²';
}

function getActiveTabId() {
  return document.querySelector('.tab-btn.active')?.dataset.target || 'tab-content-slides';
}

function activateTab(tabId) {
  if (!tabId) return;
  const tabs = Array.from(document.querySelectorAll('.tab-btn'));
  const targetTab = tabs.find((tab) => tab.dataset.target === tabId);
  if (!targetTab) return;

  tabs.forEach((tab) => tab.classList.toggle('active', tab === targetTab));
  const displayModes = {
    'tab-content-slides': 'flex',
    'tab-content-text': 'block',
    'tab-content-audio': 'block',
  };
  Object.entries(displayModes).forEach(([id, display]) => {
    const panel = document.getElementById(id);
    if (panel) panel.style.display = id === tabId ? display : 'none';
  });
}

function updateProjectStatusUi(statusText) {
  if (!elements.projectSaveBtn || !elements.projectSaveStatus) return;

  elements.projectSaveBtn.classList.toggle('is-dirty', state.project.isDirty && !state.project.isSaving);
  elements.projectSaveBtn.classList.toggle('is-saving', state.project.isSaving);
  elements.projectSaveBtn.disabled = state.project.isSaving;

  if (statusText) {
    elements.projectSaveStatus.textContent = statusText;
    return;
  }

  if (state.project.isSaving) {
    elements.projectSaveStatus.textContent = 'Ø¬Ø§Ø±Ù Ø§Ù„Ø­ÙØ¸...';
  } else if (state.project.isDirty) {
    elements.projectSaveStatus.textContent = 'ØªØºÙŠÙŠØ±Ø§Øª ØºÙŠØ± Ù…Ø­ÙÙˆØ¸Ø©';
  } else if (state.project.lastSavedAt) {
    elements.projectSaveStatus.textContent = 'ØªÙ… Ø§Ù„Ø­ÙØ¸';
  } else {
    elements.projectSaveStatus.textContent = 'Ù…Ø´Ø±ÙˆØ¹ Ø¬Ø¯ÙŠØ¯';
  }
}

function scheduleAutosave() {
  window.clearTimeout(autosaveTimerId);
  if (!state.project.autosaveEnabled || !state.project.currentProjectPath || !state.project.isDirty) {
    return;
  }

  autosaveTimerId = window.setTimeout(() => {
    saveCurrentProject({ autosave: true });
  }, PROJECT_AUTOSAVE_DELAY_MS);
}

function markProjectDirty() {
  if (isApplyingProjectData) {
    return;
  }
  projectChangeRevision += 1;
  state.project.isDirty = true;
  updateProjectStatusUi();
  scheduleAutosave();
}

function getTemplatePreset(templateId = state.selectedTemplateId) {
  return TEMPLATE_PRESETS.find((preset) => preset.id === templateId) || TEMPLATE_PRESETS[0] || null;
}

function buildTemplateDefaults(preset) {
  return { ...(preset?.defaults || {}) };
}

function getTemplateColorDefinitions(templateId = state.selectedTemplateId) {
  return TEMPLATE_COLOR_CONTROL_DEFS[templateId] || [];
}

function normalizeHexColor(rawValue, fallback) {
  if (typeof rawValue !== 'string') {
    return fallback;
  }

  const value = rawValue.trim();
  if (!value) {
    return fallback;
  }

  if (/^#[0-9a-f]{6}$/i.test(value)) {
    return value.toLowerCase();
  }

  if (/^#[0-9a-f]{3}$/i.test(value)) {
    const [, r, g, b] = value;
    return `#${r}${r}${g}${g}${b}${b}`.toLowerCase();
  }

  return fallback;
}

function buildTemplateColorDefaults(templateId = state.selectedTemplateId) {
  return getTemplateColorDefinitions(templateId).reduce((accumulator, entry) => {
    accumulator[entry.key] = entry.default;
    return accumulator;
  }, {});
}

function normalizeTemplateColors(templateId = state.selectedTemplateId, colors = {}) {
  const defaults = buildTemplateColorDefaults(templateId);
  const normalized = { ...defaults };

  getTemplateColorDefinitions(templateId).forEach((entry) => {
    normalized[entry.key] = normalizeHexColor(colors?.[entry.key], entry.default);
  });

  return normalized;
}

function isTemplateImageField(fieldOrId) {
  const target = typeof fieldOrId === 'string' ? fieldOrId : fieldOrId?.id;
  return /(img|image|avatar|photo)$/i.test(target || '');
}

function sanitizeTemplateImageValue(rawValue) {
  if (typeof rawValue !== 'string') {
    return '';
  }

  const value = rawValue.trim();
  if (!value) {
    return '';
  }

  if (value.startsWith('file://')) {
    try {
      const url = new URL(value);
      const pathname = decodeURIComponent(url.pathname || '');
      return pathname.replace(/^\/([A-Za-z]:)/, '$1');
    } catch {
      return '';
    }
  }

  if (/^[a-zA-Z]:[\\/]/.test(value) || value.startsWith('\\\\')) {
    return value;
  }

  return '';
}

function normalizeTemplateValues(preset, values = {}) {
  const defaults = buildTemplateDefaults(preset);
  const normalized = { ...defaults };
  if (!preset) {
    return normalized;
  }

  preset.fields.forEach((field) => {
    const rawValue = values[field.id];
    const nextValue = typeof rawValue === 'string' ? rawValue : (rawValue ?? defaults[field.id] ?? '');
    normalized[field.id] = isTemplateImageField(field)
      ? sanitizeTemplateImageValue(nextValue)
      : nextValue;
  });

  return normalized;
}

function buildTemplateTextFromValues(preset, values) {
  if (!preset) {
    return '';
  }

  return preset.fields
    .filter((field) => !/(img|image|avatar|photo)$/i.test(field.id))
    .map((field) => String(values?.[field.id] || '').trim())
    .filter(Boolean)
    .slice(0, 6)
    .join(' ++ ');
}

function ensureTemplateState() {
  const preset = getTemplatePreset();
  if (!preset) {
    return null;
  }

  if (!state.selectedTemplateId || !getTemplatePreset(state.selectedTemplateId)) {
    state.selectedTemplateId = preset.id;
  }

  state.templateValues = normalizeTemplateValues(preset, state.templateValues);
  state.templateColors = normalizeTemplateColors(preset.id, state.templateColors);

  if (!state.textAnimationType || state.textAnimationType === 'live-reveal-dot') {
    state.textAnimationType = preset.animationPreset || state.textAnimationType || 'motion-blur';
  }

  return preset;
}

function ensureTemplateSlide() {
  const preset = ensureTemplateState();
  if (!preset) {
    return null;
  }

  const text = buildTemplateTextFromValues(preset, state.templateValues);
  const existingSlide = state.slides.find((slide) => slide.id === TEMPLATE_SLIDE_ID) || state.slides[0] || {};
  const imagePath = existingSlide.imagePath || state.placeholderPath || '';
  const fileUrl = imagePath
    ? (existingSlide.fileUrl || window.desktopApi.toFileUrl(imagePath))
    : '';

  const templateSlide = {
    ...existingSlide,
    id: TEMPLATE_SLIDE_ID,
    imagePath,
    fileUrl,
    text,
    isMuted: true,
    voiceoverPath: existingSlide.voiceoverPath || null,
    voiceoverUrl: existingSlide.voiceoverUrl || (existingSlide.voiceoverPath ? window.desktopApi.toFileUrl(existingSlide.voiceoverPath) : null),
    voiceoverDurationMs: Number(existingSlide.voiceoverDurationMs || 0),
  };

  state.slides = [templateSlide];
  state.selectedSlideId = TEMPLATE_SLIDE_ID;
  return templateSlide;
}

function buildTemplateFieldInput(field, value) {
  const control = document.createElement(field.type === 'textarea' ? 'textarea' : 'input');
  control.className = 'input-v2';
  control.value = value;
  control.placeholder = field.placeholder || '';
  control.dir = 'rtl';
  control.autocomplete = 'off';

  if (field.type === 'textarea') {
    control.rows = Number(field.rows || 3);
    control.style.resize = 'vertical';
    control.style.lineHeight = '1.6';
    control.style.minHeight = `${Math.max(84, Number(field.rows || 3) * 24)}px`;
  } else {
    control.type = field.type || 'text';
  }

  control.addEventListener('input', (event) => {
    state.templateValues[field.id] = event.target.value;
    ensureTemplateSlide();
    markProjectDirty();
    renderPreviewFrame();
  });

  return control;
}

