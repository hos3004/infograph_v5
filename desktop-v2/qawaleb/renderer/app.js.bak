    setStatus('Ø§ÙƒØªÙ…Ù„ Ø§Ù„Ø±Ù†Ø¯Ø±', 'ØªÙ… Ø­ÙØ¸ Ø§Ù„ÙÙŠØ¯ÙŠÙˆ Ø¨Ù†Ø¬Ø§Ø­.');
